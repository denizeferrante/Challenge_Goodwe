    "section": "Demo"
  },
  "mostrarFatoresIA": {
    "editor": "boolean",
    "default": false,
    "tsType": "boolean",
    "section": "Demo"
  },
  "veiculoCadastrado": {
    "editor": "boolean",
    "default": true,
    "tsType": "boolean",
    "section": "Guardas de navegação"
  },
  "parametrizacaoConcluida": {
    "editor": "boolean",
    "default": true,
    "tsType": "boolean",
    "section": "Guardas de navegação"
  },
  "contaRepasseCadastrada": {
    "editor": "boolean",
    "default": true,
    "tsType": "boolean",
    "section": "Guardas de navegação"
  }
}

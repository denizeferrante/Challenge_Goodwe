{
  "$preview": {
    "width": 900,
    "height": 1020
  },
  "estiloEntrada": {
    "editor": "enum",
    "options": [
      "Fotográfico",
      "Ilustrado"
    ],
    "default": "Fotográfico",
    "tsType": "string",
    "section": "Tela de entrada"
  },
  "velocidadeDemo": {
    "editor": "range",
    "default": 60,
    "min": 10,
    "max": 180,
    "step": 10,
    "unit": "×",
